APP_ENV=production
APP_NAME="Construction Suite"
APP_URL=https://suite.example.com
APP_TIMEZONE=Europe/London
APP_DEBUG=false

SESSION_NAME=construction_suite
SESSION_SECURE=true
SESSION_LIFETIME=28800

DB_DRIVER=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=construction_suite
DB_USERNAME=construction_suite
DB_PASSWORD=replace-with-a-strong-password

# Required only for the one-time web installer. Use a long random value and remove it after setup.
SUITE_SETUP_KEY=replace-with-a-long-random-setup-key


# Shared secret used only for server-to-server, read-only module summaries.
# Use the same value in connected module private configs.
SUITE_INTEGRATION_KEY=
